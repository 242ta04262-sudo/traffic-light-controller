`timescale 1ns/1ps

module traffic_light_controller_tb;

    reg clk;
    reg reset;

    wire red;
    wire yellow;
    wire green;

    // Instantiate the traffic light controller
    traffic_light_controller #(
        .RED_TIME(5),
        .GREEN_TIME(5),
        .YELLOW_TIME(2)
    ) uut (
        .clk(clk),
        .reset(reset),
        .red(red),
        .yellow(yellow),
        .green(green)
    );

    // Clock generation
    initial begin
        clk = 0;

        forever #5 clk = ~clk;
    end

    // Display simulation results
    initial begin
        $display("Time\tReset\tRed\tYellow\tGreen");
        $display("---------------------------------------");

        $monitor("%0t\t%b\t%b\t%b\t%b",
                 $time, reset, red, yellow, green);
    end

    // Test sequence
    initial begin

        // Apply reset
        reset = 1;
        #10;

        // Release reset
        reset = 0;

        // Run simulation
        #130;

        $finish;
    end

endmodule